# ═══════════════════════════════════════════════════════════════
# School Management System — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ─── Database Backend ───
# The app uses SQLite (via better-sqlite3) by default — no env
# vars required. If better-sqlite3 fails to load (rare), it
# automatically falls back to a file-based JSON store at
# ./school-data.json (zero-setup dev mode).

# Optional: override the SQLite database file location.
# Defaults to ./school-data.db in process.cwd().
# Accepts absolute or relative paths (relative to process.cwd()).
# SQLITE_DB_PATH=/var/lib/school-management/data.db

# Legacy Prisma DATABASE_URL — kept for backwards compatibility
# (the actual app uses better-sqlite3 directly, NOT Prisma).
DATABASE_URL=file:/home/z/my-project/db/custom.db
